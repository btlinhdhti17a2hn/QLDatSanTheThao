@*
// Họ và tên: [Điền tên của bạn]
// Mã sinh viên: [Điền mã sinh viên của bạn]
// Nội dung thực hiện: Giao diện Razor View Đăng ký tài khoản khách hàng
*@

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold">ĐĂNG KÝ TÀI KHOẢN KHÁCH HÀNG</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center">
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="TaiKhoan" asp-action="DangKy" method="post">
                    <div class="mb-3">
                        <label class="fw-bold mb-1">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="hoTen" class="form-control" required placeholder="Nhập họ và tên..." />
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold mb-1">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input type="text" name="tenDangNhap" class="form-control" required placeholder="Nhập tên đăng nhập..." />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold mb-1">Mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="matKhau" class="form-control" required placeholder="Nhập mật khẩu..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold mb-1">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="xacNhanMatKhau" class="form-control" required placeholder="Nhập lại mật khẩu..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold mb-1">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" name="soDienThoai" class="form-control" required placeholder="Nhập số điện thoại..." />
                    </div>

                    <div class="mb-4">
                        <label class="fw-bold mb-1">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="Nhập địa chỉ email..." />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold text-uppercase">Đăng Ký Ngay</button>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                <small>Đã có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangNhap" class="text-success text-decoration-none fw-bold">Đăng nhập tại đây</a></small>
            </div>
        </div>
    </div>
</div>