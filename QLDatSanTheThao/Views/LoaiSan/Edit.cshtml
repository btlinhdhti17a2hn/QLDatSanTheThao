@model QLDatSanTheThao.Models.Entities.LoaiSan
@{
    ViewData["Title"] = "Sửa loại sân";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-white fw-bold">CẬP NHẬT LOẠI SÂN</div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="MaLoaiSan" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenLoai" class="form-label fw-bold">Tên Loại Sân <span class="text-danger">*</span></label>
                    <input asp-for="TenLoai" class="form-control" required />
                    <span asp-validation-for="TenLoai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">Mô Tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="SoNguoiToiDa" class="form-label fw-bold">Số Người Tối Đa</label>
                    <input asp-for="SoNguoiToiDa" class="form-control" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="DonGiaTheoGio" class="form-label fw-bold">Đơn Giá Theo Giờ (VNĐ)</label>
                    <input asp-for="DonGiaTheoGio" class="form-control" type="number" />
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="TrangThai" />
                    <label class="form-check-label fw-bold" asp-for="TrangThai">Đang hoạt động</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-warning text-white fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>