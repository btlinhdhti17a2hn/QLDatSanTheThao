@* 
    Họ và tên: [Điền tên SV 2]
    Mã sinh viên: [Điền mã SV 2]
    Nội dung thực hiện: View AdminIndex - Quản lý sân thể thao dạng Bảng cho Admin / Nhân viên (Module 2)
*@

@model IEnumerable<QLDatSanTheThao.Models.Entities.SanTheThao>

@{
    ViewData["Title"] = "Quản Lý Sân Thể Thao (Admin)";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-gear-wide-connected me-2"></i>Quản Lý Sân Thể Thao</h2>
            <p class="text-muted mb-0">Thêm mới, cập nhật, xóa và quản lý trạng thái các sân trong hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-success fw-bold px-3 py-2"><i class="bi bi-plus-circle me-1"></i> Thêm Sân Thể Thao Mới</a>
    </div>

    <!-- KHỐI THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THANH TÌM KIẾM CHO ADMIN -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="AdminIndex" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên sân hoặc địa chỉ...">
                </div>
                <div class="col-md-4">
                    <select name="maLoaiSan" class="form-select" asp-items="ViewBag.LoaiSans">
                        <option value="">-- Tất cả loại sân --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Tìm Kiếm</button>
                    <a asp-action="AdminIndex" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH SÂN -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Mã Sân</th>
                        <th>Tên Sân</th>
                        <th>Loại Sân</th>
                        <th>Địa Chỉ</th>
                        <th>Đơn Giá / Giờ</th>
                        <th>Giờ Mở - Đóng</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có dữ liệu sân thể thao phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@item.MaSan</td>
                                <td class="fw-bold text-dark">@item.TenSan</td>
                                <td><span class="badge bg-info text-dark">@item.LoaiSan.TenLoai</span></td>
                                <td class="small">@item.DiaChi</td>
                                <td class="fw-bold text-danger">@item.DonGia.ToString("N0") đ</td>
                                <td class="small">@item.GioMoCua.ToString(@"hh\:mm") - @item.GioDongCua.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm đóng cửa</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaSan" class="btn btn-outline-info" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.MaSan" class="btn btn-outline-warning" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        <form asp-action="Delete" asp-route-id="@item.MaSan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sân này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa sân"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
