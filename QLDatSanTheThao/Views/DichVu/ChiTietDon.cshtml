@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Chi tiết đơn đặt sân: thêm dịch vụ, tự động tính tổng tiền. *@
@model QLDatSanTheThao.Models.ViewModels.ChiTietDonViewModel
@{
    ViewData["Title"] = "Dịch vụ & tính tiền";
    var dichVuList = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.DichVuList;

    var trangThai = Model.DatSan.TrangThai?.ToString() ?? "";
    var badgeClass = trangThai switch
    {
        "Đang xử lý" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "Đã hủy" => "bg-danger-subtle text-danger-emphasis border border-danger-subtle",
        "Hoàn thành" or "Đã thanh toán" => "bg-success-subtle text-success-emphasis border border-success-subtle",
        _ => "bg-info-subtle text-info-emphasis border border-info-subtle"
    };
}

<style>
    /* Nền xám nhạt để các khối trắng nổi lên rõ ràng */
    body {
        background-color: #e9edf4;
    }

    .dv-page {
        max-width: 1140px;
    }

    .dv-card {
        background: #fff;
        border: 1px solid #cfd6e2;
        border-radius: .65rem;
        box-shadow: 0 2px 6px rgba(30, 41, 59, .08);
        overflow: hidden;
    }

    .dv-card-head {
        padding: .6rem 1rem;
        background: #f3f6fb;
        border-bottom: 1px solid #d9dfea;
        border-left: 4px solid #0d6efd;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
    }

    .dv-card-body {
        padding: .85rem 1rem;
    }

    .dv-info {
        display: grid;
        grid-template-columns: 100px 1fr;
        gap: .45rem .75rem;
        margin: 0;
    }

        .dv-info dt {
            font-weight: 400;
            color: #6b7280;
        }

        .dv-info dd {
            margin: 0;
            font-weight: 600;
            color: #111827;
        }

    .dv-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: .45rem 0;
    }

        .dv-row + .dv-row {
            border-top: 1px dashed #d5dbe5;
        }

        .dv-row .sub {
            display: block;
            font-size: .8rem;
            color: #6b7280;
        }

    .dv-total {
        background: #f3f6fb;
        border: 1px solid #d9dfea;
        border-radius: .5rem;
        padding: .6rem .85rem;
        margin-top: .4rem;
    }

    .dv-pay {
        background: #fef2f2;
        border: 1px solid #f5b5b5;
        border-radius: .5rem;
        padding: .75rem .85rem;
        margin-top: .6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .dv-pay .amount {
            font-size: 1.4rem;
            font-weight: 700;
            color: #b91c1c;
            line-height: 1;
        }

    /* Form: khoảng cách gọn, viền ô nhập đậm hơn để dễ nhận biết */
    .dv-card .form-label {
        margin-bottom: .2rem;
        font-weight: 600;
        font-size: .9rem;
    }

    .dv-card .form-control, .dv-card .form-select {
        border-color: #aab4c5;
    }

        .dv-card .form-control:focus, .dv-card .form-select:focus {
            border-color: #0d6efd;
        }

    .dv-qty input {
        text-align: center;
    }

    .dv-table th {
        font-size: .8rem;
        color: #4b5563;
        font-weight: 600;
        background: #f3f6fb;
        white-space: nowrap;
        padding: .5rem .75rem;
    }

    .dv-table td {
        padding: .55rem .75rem;
        vertical-align: middle;
    }

    .dv-table .money {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .dv-empty {
        padding: 1.5rem 1rem;
        text-align: center;
        color: #6b7280;
    }

        .dv-empty .icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #e7f0ff;
            color: #0d6efd;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .5rem;
        }

    /* Thanh thao tác cố định phía dưới */
    .dv-actionbar {
        position: sticky;
        bottom: .75rem;
        z-index: 10;
        margin-top: 1.25rem;
        background: #fff;
        border: 1px solid #cfd6e2;
        border-radius: .65rem;
        box-shadow: 0 -2px 12px rgba(30, 41, 59, .12);
        padding: .65rem 1rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

        .dv-actionbar .due {
            line-height: 1.2;
        }

            .dv-actionbar .due small {
                display: block;
                color: #6b7280;
            }

            .dv-actionbar .due strong {
                font-size: 1.15rem;
                color: #b91c1c;
            }

    @@media (max-width: 575.98px) {
        .dv-actionbar .btn {
            flex: 1 1 auto;
        }

        .dv-pay .amount {
            font-size: 1.2rem;
        }
    }

    @@media print {
        body {
            background: #fff;
        }

        .dv-actionbar, .dv-add, .dv-col-action, .navbar, footer {
            display: none !important;
        }

        .dv-card {
            box-shadow: none;
        }
    }
</style>

<div class="dv-page mx-auto py-3 px-2">

    @* ===== Tiêu đề ===== *@
    <div class="mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="DonDatSan" class="text-decoration-none">Đơn đặt sân</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đơn #@Model.DatSan.MaDatSan</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2 flex-wrap">
            Dịch vụ &amp; tính tiền
            <span class="badge rounded-pill fs-6 fw-semibold @badgeClass">@trangThai</span>
        </h1>
    </div>

    <partial name="_ThongBaoDichVu" />

    <div class="row g-3">

        @* ===== CỘT TRÁI ===== *@
        <div class="col-lg-5">
            <div class="d-grid gap-3">

                <section class="dv-card">
                    <div class="dv-card-head">Thông tin đơn đặt sân <span class="text-muted fw-normal small">#@Model.DatSan.MaDatSan</span></div>
                    <div class="dv-card-body">
                        <dl class="dv-info">
                            <dt>Khách hàng</dt>
                            <dd>@Model.DatSan.KhachHang?.HoTen</dd>
                            <dt>Sân</dt>
                            <dd>@Model.DatSan.SanTheThao?.TenSan</dd>
                            <dt>Ngày</dt>
                            <dd>@Model.DatSan.NgayDat.ToString("dd/MM/yyyy")</dd>
                            <dt>Khung giờ</dt>
                            <dd>@Model.DatSan.GioBatDau.ToString("HH:mm") - @Model.DatSan.GioKetThuc.ToString("HH:mm") <span class="text-muted fw-normal">(@Model.SoGio.ToString("0.##") giờ)</span></dd>
                        </dl>
                    </div>
                </section>

                <section class="dv-card">
                    <div class="dv-card-head">Chi tiết thanh toán</div>
                    <div class="dv-card-body">
                        <div class="dv-row">
                            <span>Tiền sân<span class="sub">@Model.DatSan.DonGia.ToString("N0") đ &times; @Model.SoGio.ToString("0.##") giờ</span></span>
                            <span class="fw-semibold">@Model.TienSan.ToString("N0") đ</span>
                        </div>
                        <div class="dv-row">
                            <span>Tiền dịch vụ<span class="sub">@Model.ChiTiets.Count() mục</span></span>
                            <span class="fw-semibold">@Model.TienDichVu.ToString("N0") đ</span>
                        </div>
                        <div class="dv-total">
                            <div class="d-flex justify-content-between fw-bold"><span>Tổng tiền</span><span>@Model.TongTien.ToString("N0") đ</span></div>
                            <div class="d-flex justify-content-between text-muted mt-1"><span>Đã cọc</span><span>- @Model.DatSan.TienCoc.ToString("N0") đ</span></div>
                        </div>
                        <div class="dv-pay">
                            <span class="fw-semibold text-danger-emphasis">Còn phải thanh toán</span>
                            <span class="amount">@Model.ConPhaiTra.ToString("N0") đ</span>
                        </div>
                    </div>
                </section>

            </div>
        </div>

        @* ===== CỘT PHẢI ===== *@
        <div class="col-lg-7">
            <div class="d-grid gap-3">

                @if (Model.ChoPhepThem)
                {
                    <section class="dv-card dv-add">
                        <div class="dv-card-head">Thêm dịch vụ vào đơn</div>
                        <div class="dv-card-body">
                            <form asp-action="ThemVaoDon" method="post" class="row g-2 align-items-end" id="formThemDichVu">
                                <input type="hidden" name="maDatSan" value="@Model.DatSan.MaDatSan" />

                                <div class="col-sm-7">
                                    <label for="maDichVu" class="form-label">Dịch vụ</label>
                                    <select id="maDichVu" name="maDichVu" class="form-select" required>
                                        <option value="">Chọn dịch vụ</option>
                                        @foreach (var item in dichVuList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-sm-5">
                                    <label for="soLuong" class="form-label">Số lượng</label>
                                    <div class="input-group dv-qty">
                                        <button class="btn btn-outline-secondary" type="button" data-step="-1" aria-label="Giảm số lượng">&minus;</button>
                                        <input id="soLuong" type="number" name="soLuong" value="1" min="1" max="100" class="form-control" required />
                                        <button class="btn btn-outline-secondary" type="button" data-step="1" aria-label="Tăng số lượng">+</button>
                                    </div>
                                </div>

                                <div class="col-sm-9">
                                    <label for="ghiChu" class="form-label">Ghi chú <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                                    <input id="ghiChu" type="text" name="ghiChu" class="form-control" maxlength="300" placeholder="Ví dụ: giao ra sân lúc 17:30" />
                                </div>

                                <div class="col-sm-3 d-grid">
                                    <button type="submit" class="btn btn-primary" id="btnThem">+ Thêm vào đơn</button>
                                </div>
                            </form>
                        </div>
                    </section>
                }
                else
                {
                    <div class="alert alert-secondary mb-0" role="alert">
                        Đơn không ở trạng thái <strong>"Đang xử lý"</strong> nên không thể thêm hoặc xóa dịch vụ.
                    </div>
                }

                <section class="dv-card">
                    <div class="dv-card-head">
                        Dịch vụ đã sử dụng
                        <span class="badge text-bg-primary">@Model.ChiTiets.Count() mục</span>
                    </div>

                    @if (!Model.ChiTiets.Any())
                    {
                        <div class="dv-empty">
                            <div class="icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z" /><path d="M6 6 5 3H2" /><circle cx="9" cy="20" r="1" /><circle cx="18" cy="20" r="1" /></svg>
                            </div>
                            <div class="fw-semibold text-dark">Chưa có dịch vụ nào trong đơn</div>
                            @if (Model.ChoPhepThem)
                            {
                                <div class="small">Chọn dịch vụ ở phía trên để thêm vào đơn.</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table dv-table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Dịch vụ</th>
                                        <th class="text-end">SL</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                        <th>Ghi chú</th>
                                        <th class="dv-col-action" style="width:1%"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.ChiTiets)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@c.DichVu?.TenDichVu</td>
                                            <td class="text-end">@c.SoLuong</td>
                                            <td class="text-end money">@c.DonGia.ToString("N0") đ</td>
                                            <td class="text-end money fw-semibold">@c.ThanhTien.ToString("N0") đ</td>
                                            <td class="text-muted">@(string.IsNullOrWhiteSpace(c.GhiChu) ? "—" : c.GhiChu)</td>
                                            <td class="text-end dv-col-action">
                                                @if (Model.ChoPhepThem)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal" data-bs-target="#modalXoa"
                                                            data-ma="@c.MaChiTiet" data-ten="@c.DichVu?.TenDichVu">
                                                        Xóa
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <td colspan="3" class="text-end fw-semibold">Tổng tiền dịch vụ</td>
                                        <td class="text-end money fw-bold">@Model.TienDichVu.ToString("N0") đ</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </section>

            </div>
        </div>
    </div>

    @* ===== Thanh thao tác ===== *@
    <div class="dv-actionbar">
        <div class="due">
            <small>Còn phải thanh toán</small>
            <strong>@Model.ConPhaiTra.ToString("N0") đ</strong>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="DonDatSan" class="btn btn-outline-secondary" id="btnQuayLai">Quay lại danh sách</a>
            <button type="button" class="btn btn-outline-primary" onclick="window.print()">In hóa đơn</button>
            <a asp-action="DonDatSan" class="btn btn-success px-4 fw-semibold" id="btnLuuDon">Lưu đơn</a>
        </div>
    </div>
</div>

@* ===== Hộp thoại xác nhận xóa ===== *@
@if (Model.ChoPhepThem)
{
    <div class="modal fade" id="modalXoa" tabindex="-1" aria-labelledby="modalXoaTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="XoaKhoiDon" method="post" class="modal-content">
                <input type="hidden" name="maChiTiet" id="xoaMaChiTiet" />
                <div class="modal-header">
                    <h5 class="modal-title" id="modalXoaTitle">Xóa dịch vụ khỏi đơn?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    Bạn sắp xóa <strong id="xoaTenDichVu"></strong> khỏi đơn #@Model.DatSan.MaDatSan. Tổng tiền sẽ được tính lại.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Giữ lại</button>
                    <button type="submit" class="btn btn-danger">Xóa dịch vụ</button>
                </div>
            </form>
        </div>
    </div>
}

<script>
    (function () {
        var qty = document.getElementById('soLuong');
        var select = document.getElementById('maDichVu');
        var form = document.getElementById('formThemDichVu');

        // Nút +/- số lượng
        document.querySelectorAll('[data-step]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!qty) return;
                var next = (parseInt(qty.value, 10) || 1) + parseInt(btn.dataset.step, 10);
                qty.value = Math.min(parseInt(qty.max, 10) || 100, Math.max(parseInt(qty.min, 10) || 1, next));
            });
        });

        // Chống bấm "Thêm vào đơn" nhiều lần
        if (form) {
            form.addEventListener('submit', function () {
                var b = document.getElementById('btnThem');
                if (form.checkValidity() && b) { b.disabled = true; b.textContent = 'Đang thêm...'; }
            });
        }

        // Lưu đơn: nếu đã chọn dịch vụ mà chưa bấm "Thêm vào đơn" thì nhắc người dùng
        // (Mỗi dịch vụ được lưu vào CSDL ngay khi bấm "Thêm vào đơn")
        var btnLuu = document.getElementById('btnLuuDon');
        if (btnLuu && form && select) {
            btnLuu.addEventListener('click', function (e) {
                if (select.value) {
                    e.preventDefault();
                    if (confirm('Bạn đã chọn dịch vụ nhưng chưa thêm vào đơn.\nBấm OK để thêm dịch vụ này rồi tiếp tục, Hủy để đóng.')) {
                        form.requestSubmit();
                    }
                }
            });
        }

        // Hộp thoại xóa
        var modal = document.getElementById('modalXoa');
        if (modal) {
            modal.addEventListener('show.bs.modal', function (e) {
                var t = e.relatedTarget;
                document.getElementById('xoaMaChiTiet').value = t.getAttribute('data-ma');
                document.getElementById('xoaTenDichVu').textContent = t.getAttribute('data-ten');
            });
        }
    })();
</script>
