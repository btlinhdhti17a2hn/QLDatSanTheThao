@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Form thêm dịch vụ (Admin). *@
@model QLDatSanTheThao.Models.Entities.DichVu
@{
    ViewData["Title"] = "Thêm dịch vụ";
}

<style>
    /* Nền xám xanh để các khối trắng nổi rõ */
    body {
        background: #e9edf4;
    }

    .svc {
        --svc-border: #cfd6e2;
        --svc-ink: #1d2433;
        --svc-muted: #5f6b7e;
        --svc-brand: #0d6efd;
        --svc-field: #aab4c5;
    }

    .validation-summary-valid {
        display: none;
    }

    .field-validation-error {
        display: block;
        margin-top: .2rem;
        font-size: .85rem;
    }

    /* Đầu trang */
    .svc-back {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: var(--svc-muted);
        font-size: .9rem;
        text-decoration: none;
    }

        .svc-back:hover {
            color: var(--svc-brand);
        }

    .svc-title {
        margin: .25rem 0 .15rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--svc-ink);
    }

    .svc-sub {
        margin: 0;
        color: var(--svc-muted);
        font-size: .95rem;
    }

    /* Khối */
    .svc-card {
        background: #fff;
        border: 1px solid var(--svc-border);
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(30, 41, 59, .08);
        overflow: hidden;
    }

        .svc-card + .svc-card {
            margin-top: .85rem;
        }

    .svc-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        padding: .6rem 1rem;
        background: #f3f6fb;
        border-bottom: 1px solid #d9dfea;
        border-left: 4px solid var(--svc-brand);
    }

        .svc-card-head h2 {
            margin: 0;
            font-size: .98rem;
            font-weight: 700;
            color: var(--svc-ink);
        }

    .svc-card-body {
        padding: 1rem;
    }

    /* Trường nhập */
    .svc-label {
        margin-bottom: .25rem;
        font-size: .9rem;
        font-weight: 600;
        color: var(--svc-ink);
    }

    .svc .form-control, .svc .input-group-text {
        min-height: 40px;
        border-color: var(--svc-field);
        border-radius: 8px;
    }

    .svc .input-group > .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .svc .input-group > .input-group-text {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        background: #eef2f8;
        color: var(--svc-muted);
        font-weight: 600;
    }

    .svc .form-control::placeholder {
        color: #8d98aa;
    }

    .svc .form-control:focus {
        border-color: var(--svc-brand);
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
    }

    .svc textarea.form-control {
        min-height: 84px;
        resize: vertical;
    }

    .svc .input-validation-error {
        border-color: #dc3545;
    }

        .svc .input-validation-error:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 .2rem rgba(220, 53, 69, .15);
        }

    .svc input[type=number] {
        -moz-appearance: textfield;
        appearance: textfield;
    }

        .svc input[type=number]::-webkit-outer-spin-button,
        .svc input[type=number]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .svc-hint {
        margin-top: .3rem;
        font-size: .84rem;
        color: var(--svc-muted);
    }

    .svc-count {
        font-size: .8rem;
        color: var(--svc-muted);
    }

    /* Gợi ý giá */
    .svc-chip {
        padding: .15rem .75rem;
        border: 1px solid var(--svc-field);
        border-radius: 999px;
        background: #fff;
        color: #344054;
        font-size: .84rem;
        font-weight: 500;
        transition: background-color .15s, border-color .15s, color .15s;
    }

        .svc-chip:hover {
            border-color: var(--svc-brand);
            background: #f1f7ff;
            color: var(--svc-brand);
        }

        .svc-chip.active {
            border-color: var(--svc-brand);
            background: var(--svc-brand);
            color: #fff;
        }

    /* Trạng thái */
    .svc-badge {
        display: inline-block;
        padding: .15rem .6rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }

        .svc-badge.on {
            background: #dff3e8;
            color: #137a4b;
        }

        .svc-badge.off {
            background: #e5e8ee;
            color: #5f6b7e;
        }

    .svc .form-switch .form-check-input {
        width: 2.75rem;
        height: 1.5rem;
        margin: 0;
        cursor: pointer;
    }

    /* Xem trước */
    .svc-preview {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .65rem;
        border: 1px dashed #b7c1d2;
        border-radius: 10px;
        background: #f8fafd;
        transition: opacity .2s;
    }

        .svc-preview.is-off {
            opacity: .55;
        }

    .svc-avatar {
        flex: none;
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #dbe9ff;
        color: var(--svc-brand);
        font-weight: 700;
    }

    .svc-pv-main {
        flex: 1;
        min-width: 0;
    }

    .svc-pv-name {
        overflow: hidden;
        font-weight: 600;
        color: var(--svc-ink);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .svc-pv-desc {
        display: -webkit-box;
        overflow: hidden;
        font-size: .8rem;
        color: var(--svc-muted);
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .svc-pv-price {
        flex: none;
        font-weight: 700;
        color: var(--svc-brand);
        white-space: nowrap;
    }

    .is-empty {
        color: #8d98aa !important;
        font-weight: 400;
    }

    /* Thanh thao tác cố định cuối màn hình */
    .svc-actions {
        position: sticky;
        bottom: .75rem;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
        padding: .6rem 1rem;
        border: 1px solid var(--svc-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 -2px 12px rgba(30, 41, 59, .14);
    }

        .svc-actions .btn {
            min-height: 38px;
            padding-inline: 1.2rem;
            font-weight: 600;
            border-radius: 8px;
        }

    @@media (min-width: 992px) {
        .svc-aside {
            position: sticky;
            top: 1rem;
        }
    }

    @@media (max-width: 575.98px) {
        .svc-chip {
            padding: .15rem .55rem;
        }

        .svc-actions {
            padding: .6rem;
        }

            .svc-actions .svc-required {
                display: none;
            }

            .svc-actions .svc-btns {
                display: flex;
                flex: 1;
                gap: .5rem;
            }

            .svc-actions .btn {
                flex: 1;
                padding-inline: .5rem;
            }
    }
</style>

<div class="svc py-3">
    <a asp-action="Index" class="svc-back">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Danh sách dịch vụ
    </a>
    <h1 class="svc-title">Thêm dịch vụ</h1>
    <p class="svc-sub">Tạo dịch vụ khách có thể chọn thêm khi đặt sân, như thuê giày, nước uống hay trọng tài.</p>

    <form asp-action="Create" method="post" id="serviceForm" class="mt-3" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="row g-3">
            <!-- Cột chính -->
            <div class="col-lg-8">
                <div class="svc-card">
                    <div class="svc-card-head"><h2>Thông tin dịch vụ</h2></div>
                    <div class="svc-card-body">

                        <div class="mb-3">
                            <label asp-for="TenDichVu" class="svc-label">Tên dịch vụ <span class="text-danger">*</span></label>
                            <input asp-for="TenDichVu" class="form-control" placeholder="Ví dụ: Thuê giày đá bóng" autocomplete="off" autofocus />
                            <span asp-validation-for="TenDichVu" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DonGia" class="svc-label">Đơn giá <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="DonGia" type="number" min="0" step="1000" inputmode="numeric" class="form-control" placeholder="0" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <span asp-validation-for="DonGia" class="text-danger"></span>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                <span class="svc-hint m-0 d-none d-sm-inline">Chọn nhanh:</span>
                                <button type="button" class="svc-chip" data-value="10000" aria-pressed="false">10.000</button>
                                <button type="button" class="svc-chip" data-value="20000" aria-pressed="false">20.000</button>
                                <button type="button" class="svc-chip" data-value="50000" aria-pressed="false">50.000</button>
                                <button type="button" class="svc-chip" data-value="100000" aria-pressed="false">100.000</button>
                                <span class="svc-hint m-0 ms-1" id="priceHint">Nhập 0 nếu dịch vụ miễn phí.</span>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between align-items-end">
                                <label asp-for="MoTa" class="svc-label">Mô tả</label>
                                <span class="svc-count mb-1" id="moTaCount"></span>
                            </div>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Ví dụ: Giày size 38–44, giá theo mỗi lượt thuê."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Cột phụ -->
            <div class="col-lg-4">
                <div class="svc-aside">
                    <div class="svc-card">
                        <div class="svc-card-head">
                            <h2>Trạng thái</h2>
                            <span class="svc-badge on" id="statusBadge">Đang cung cấp</span>
                        </div>
                        <div class="svc-card-body">
                            <div class="d-flex justify-content-between align-items-center gap-3">
                                <label asp-for="TrangThai" class="svc-label m-0" style="cursor:pointer">Cung cấp dịch vụ này</label>
                                <div class="form-check form-switch m-0 p-0">
                                    <input asp-for="TrangThai" class="form-check-input" type="checkbox" role="switch" />
                                </div>
                            </div>
                            <div class="svc-hint">Khi tắt, dịch vụ sẽ bị ẩn khỏi danh sách đặt sân.</div>
                        </div>
                    </div>

                    <div class="svc-card">
                        <div class="svc-card-head"><h2>Xem trước</h2></div>
                        <div class="svc-card-body">
                            <div class="svc-preview" id="pv">
                                <div class="svc-avatar" id="pvAvatar">+</div>
                                <div class="svc-pv-main">
                                    <div class="svc-pv-name is-empty" id="pvName">Tên dịch vụ</div>
                                    <div class="svc-pv-desc is-empty" id="pvDesc">Chưa có mô tả</div>
                                </div>
                                <div class="svc-pv-price" id="pvPrice">Miễn phí</div>
                            </div>
                            <div class="svc-hint">Cách dịch vụ hiển thị khi khách đặt sân.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="svc-actions">
            <span class="svc-hint m-0 svc-required"><span class="text-danger">*</span> Trường bắt buộc</span>
            <div class="svc-btns d-flex gap-2">
                <button type="reset" class="btn btn-link text-secondary text-decoration-none" id="btnReset">Nhập lại</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary" id="btnSave">Lưu dịch vụ</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var byId = function (id) { return document.getElementById(id); };
            var form = byId('serviceForm'), btn = byId('btnSave');
            var name = byId('TenDichVu'), price = byId('DonGia'), desc = byId('MoTa'), status = byId('TrangThai');
            var chips = Array.prototype.slice.call(document.querySelectorAll('.svc-chip'));
            var fmt = new Intl.NumberFormat('vi-VN');
            var saveText = btn.innerHTML;

            // Giới hạn ký tự lấy từ [StringLength]/[MaxLength] của model (nếu có)
            var max = parseInt(desc.getAttribute('data-val-length-max') || desc.getAttribute('data-val-maxlength-max'), 10);
            if (max) desc.setAttribute('maxlength', max);

            function money(v) { return v > 0 ? fmt.format(v) + ' đ' : 'Miễn phí'; }

            function render() {
                var n = name.value.trim(), d = desc.value.trim(), p = parseFloat(price.value);
                if (isNaN(p) || p < 0) p = 0;

                byId('pvName').textContent = n || 'Tên dịch vụ';
                byId('pvName').classList.toggle('is-empty', !n);
                byId('pvDesc').textContent = d || 'Chưa có mô tả';
                byId('pvDesc').classList.toggle('is-empty', !d);
                byId('pvAvatar').textContent = n ? n.charAt(0).toUpperCase() : '+';
                byId('pvPrice').textContent = money(p);
                byId('priceHint').textContent = p > 0 ? 'Khách sẽ thấy: ' + money(p) : 'Nhập 0 nếu dịch vụ miễn phí.';

                chips.forEach(function (c) {
                    var on = Number(c.dataset.value) === p;
                    c.classList.toggle('active', on);
                    c.setAttribute('aria-pressed', on);
                });

                var open = status.checked, badge = byId('statusBadge');
                badge.className = 'svc-badge ' + (open ? 'on' : 'off');
                badge.textContent = open ? 'Đang cung cấp' : 'Tạm ngưng';
                byId('pv').classList.toggle('is-off', !open);

                byId('moTaCount').textContent = max ? desc.value.length + '/' + max : '';
            }

            [name, price, desc].forEach(function (el) { el.addEventListener('input', render); });
            status.addEventListener('change', render);

            chips.forEach(function (c) {
                c.addEventListener('click', function () {
                    price.value = c.dataset.value;
                    render();
                    if (window.jQuery && jQuery.fn.valid) { try { jQuery(price).valid(); } catch (e) { } }
                    price.focus();
                });
            });

            // Ô số: chọn hết khi focus, chặn ký tự lạ và cuộn chuột làm đổi giá trị
            price.addEventListener('focus', function () { this.select(); });
            price.addEventListener('wheel', function () { this.blur(); }, { passive: true });
            price.addEventListener('keydown', function (e) {
                if (['e', 'E', '+', '-'].indexOf(e.key) !== -1) e.preventDefault();
            });

            // Nhập lại: đưa form về ban đầu, cập nhật xem trước, xóa thông báo lỗi
            form.addEventListener('reset', function () {
                setTimeout(function () {
                    render();
                    if (window.jQuery && jQuery.fn.validate) { try { jQuery(form).validate().resetForm(); } catch (e) { } }
                    form.querySelectorAll('.input-validation-error').forEach(function (el) { el.classList.remove('input-validation-error'); });
                    name.focus();
                }, 0);
            });

            // Chống bấm Lưu nhiều lần khi form hợp lệ
            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery.fn.valid && !jQuery(form).valid()) return;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Đang lưu...';
            });
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) { btn.disabled = false; btn.innerHTML = saveText; }
            });

            render();
        })();
    </script>
}
