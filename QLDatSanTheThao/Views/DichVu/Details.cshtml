@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Chi tiết dịch vụ. *@
@model QLDatSanTheThao.Models.Entities.DichVu
@{
    ViewData["Title"] = "Chi tiết dịch vụ";
    int daSuDung = ViewBag.DaSuDung ?? 0;
    decimal tongTien = Model.DonGia * daSuDung;

    // Tự động phân loại icon trực quan dựa theo tên dịch vụ (đồng bộ giao diện)
    string iconClass = "bi-box-seam";
    string tenLower = Model.TenDichVu?.ToLower() ?? "";
    if (tenLower.Contains("nước") || tenLower.Contains("aquafina") || tenLower.Contains("redbull") || tenLower.Contains("giải khát"))
    {
        iconClass = "bi-cup-straw text-info";
    }
    else if (tenLower.Contains("áo") || tenLower.Contains("bib") || tenLower.Contains("quần"))
    {
        iconClass = "bi-tshirt text-warning";
    }
    else if (tenLower.Contains("bóng") || tenLower.Contains("vợt") || tenLower.Contains("cầu lông"))
    {
        iconClass = "bi-controller text-success";
    }
}

<!-- Sử dụng Bootstrap Icons cho giao diện trực quan -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid px-4 py-3">
    <!-- Tiêu đề trang & Nút quay lại -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Chi tiết dịch vụ</h2>
            <p class="text-muted mb-0">Xem thông tin chi tiết, đơn giá và tổng doanh thu từ dịch vụ đi kèm.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Khu vực hiển thị thông tin chi tiết dạng Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <!-- Header của Card hiển thị icon và tên dịch vụ -->
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-light d-flex align-items-center justify-content-center border" style="width: 50px; height: 50px;">
                        <i class="bi @iconClass fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">@Model.TenDichVu</h4>
                        <span class="text-muted small">Mã dịch vụ: #@Model.MaDichVu</span>
                    </div>
                </div>

                <!-- Thân Card: Chi tiết các thuộc tính -->
                <div class="card-body p-4 p-md-5">
                    <dl class="row mb-0 gy-4">
                        <dt class="col-sm-4 text-secondary fw-semibold">
                            <i class="bi bi-tag me-1"></i> Tên dịch vụ
                        </dt>
                        <dd class="col-sm-8 fw-bold text-dark mb-0">
                            @Model.TenDichVu
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">
                            <i class="bi bi-currency-dollar me-1"></i> Đơn giá
                        </dt>
                        <dd class="col-sm-8 fw-bold text-primary fs-5 mb-0">
                            @Model.DonGia.ToString("N0") đ
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">
                            <i class="bi bi-card-text me-1"></i> Mô tả
                        </dt>
                        <dd class="col-sm-8 text-muted mb-0">
                            @(string.IsNullOrWhiteSpace(Model.MoTa) ? "(không có mô tả)" : Model.MoTa)
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">
                            <i class="bi bi-toggle-on me-1"></i> Trạng thái
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-dash-circle-fill me-1"></i> Ngừng cung cấp
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">
                            <i class="bi bi-cart-check me-1"></i> Đã sử dụng
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            <span class="fw-bold text-dark">@daSuDung</span>
                            <span class="text-muted small">(tổng số lượng trong các đơn đặt sân)</span>
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">
                            <i class="bi bi-cash-stack me-1"></i> Tổng tiền
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            <span class="fw-bold text-success fs-4">@tongTien.ToString("N0") đ</span>
                            <span class="text-muted small d-block mt-1">(= Đơn giá @Model.DonGia.ToString("N0") đ × Số lượng đã sử dụng @daSuDung)</span>
                        </dd>
                    </dl>
                </div>

                <!-- Footer Card chứa nút quay lại -->
                <div class="card-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary d-inline-flex align-items-center gap-1 shadow-sm px-4">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>