@* Họ và tên: Tạ Đình Kim 
   Mã sinh viên: 23103100315   
   Nội dung thực hiện: Chi tiết dịch vụ. *@
@model QLDatSanTheThao.Models.Entities.DichVu
@{
    ViewData["Title"] = "Chi tiết dịch vụ";
    int daSuDung = ViewBag.DaSuDung ?? 0;
    decimal tongTien = Model.DonGia * daSuDung;
}

<!-- Sử dụng Bootstrap cho giao diện -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container-fluid px-4 py-3">
    <!-- Tiêu đề trang & Nút quay lại -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Chi tiết dịch vụ</h2>
            <p class="text-muted mb-0">Xem thông tin chi tiết, đơn giá và tổng doanh thu từ dịch vụ đi kèm.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-3">
                Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Khu vực hiển thị thông tin chi tiết dạng Card -->
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border shadow-sm rounded-4 overflow-hidden">
                <!-- Header của Card chỉ hiển thị tên dịch vụ -->
                <div class="card-header bg-light border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">@Model.TenDichVu</h5>
                    <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill">Mã: #@ViewBag.SoThuTu</span>
                </div>

                <!-- Thân Card -->
                <div class="card-body p-4">
                    <dl class="row mb-0 gy-3 align-items-center">
                        <dt class="col-sm-4 text-secondary fw-semibold">Tên dịch vụ</dt>
                        <dd class="col-sm-8 fw-bold text-dark mb-0">
                            @Model.TenDichVu
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">Đơn giá</dt>
                        <dd class="col-sm-8 fw-bold text-primary fs-5 mb-0">
                            @Model.DonGia.ToString("N0") đ
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">Mô tả</dt>
                        <dd class="col-sm-8 text-muted mb-0">
                            @(string.IsNullOrWhiteSpace(Model.MoTa) ? "(không có mô tả)" : Model.MoTa)
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">Trạng thái</dt>
                        <dd class="col-sm-8 mb-0">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                    Ngừng cung cấp
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">Đã sử dụng</dt>
                        <dd class="col-sm-8 mb-0">
                            <span class="fw-bold text-dark">@daSuDung</span>
                            <span class="text-muted small ms-1">(tổng số lượng đặt)</span>
                        </dd>

                        <dt class="col-sm-4 text-secondary fw-semibold">Tổng tiền</dt>
                        <dd class="col-sm-8 mb-0">
                            <span class="fw-bold text-success fs-4">@tongTien.ToString("N0") đ</span>
                            <span class="text-muted small d-block mt-1">(= Đơn giá @Model.DonGia.ToString("N0") đ × Số lượng @daSuDung)</span>
                        </dd>
                    </dl>
                </div>

                <!-- Footer Card chứa nút quay lại -->
                <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

