@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Danh sách đơn đang xử lý để chọn đơn thêm dịch vụ. *@
@model List<QLDatSanTheThao.Models.Entities.DatSan>
@{
    ViewData["Title"] = "Đơn đang xử lý";
    string tuKhoa = ViewBag.TuKhoa as string;
    var dsDon = Model.OrderBy(d => d.NgayDat).ThenBy(d => d.GioBatDau).ThenBy(d => d.MaDatSan).ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .dv-wrap {
        max-width: 1040px;
        margin: 32px auto 48px;
        padding: 0 16px;
    }

    .dv-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .dv-title {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
        color: #1f2937;
    }

    .dv-sub {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: .95rem;
    }

    .dv-count {
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: .9rem;
        white-space: nowrap;
    }

    .dv-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(17, 24, 39, .06);
        overflow: hidden;
    }

    .dv-toolbar {
        padding: 16px 20px;
        border-bottom: 1px solid #eef0f3;
        background: #fafbfc;
    }

    .dv-search .input-group-text {
        background: #fff;
        border-right: 0;
        color: #9ca3af;
    }

    .dv-search .form-control {
        border-left: 0;
        box-shadow: none;
    }

        .dv-search .form-control:focus {
            border-color: #ced4da;
        }

    .dv-search .btn-clear {
        border: 1px solid #ced4da;
        border-left: 0;
        background: #fff;
        color: #6b7280;
    }

        .dv-search .btn-clear:hover {
            color: #dc2626;
            background: #fff;
        }

    .dv-search .btn-find {
        min-width: 90px;
        font-weight: 600;
    }

    .dv-table {
        margin: 0;
    }

        .dv-table thead th {
            background: #f3f4f6;
            color: #4b5563;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 700;
            border-bottom: 1px solid #e5e7eb;
            padding: 12px 16px;
            white-space: nowrap;
        }

        .dv-table tbody td {
            padding: 14px 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f2f4;
        }

        .dv-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .dv-table tbody tr {
            transition: background .15s;
        }

            .dv-table tbody tr:hover {
                background: #f5f9ff;
            }

    .dv-id {
        font-weight: 700;
        color: #374151;
    }

    .dv-cust {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dv-avatar {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: .85rem;
    }

    .dv-main {
        font-weight: 600;
        color: #1f2937;
        line-height: 1.25;
    }

    .dv-muted {
        color: #6b7280;
        font-size: .85rem;
        line-height: 1.25;
    }

    .dv-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fef3c7;
        color: #92400e;
        font-weight: 600;
        font-size: .8rem;
        padding: 5px 12px;
        border-radius: 999px;
        white-space: nowrap;
    }

        .dv-badge::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #f59e0b;
        }

    .dv-action {
        white-space: nowrap;
        font-weight: 600;
        border-radius: 8px;
        padding: 6px 14px;
    }

    .dv-empty {
        padding: 56px 16px;
        text-align: center;
        color: #6b7280;
    }

        .dv-empty i {
            font-size: 2.6rem;
            color: #cbd5e1;
            display: block;
            margin-bottom: 8px;
        }

    .dv-foot {
        padding: 12px 20px;
        border-top: 1px solid #eef0f3;
        background: #fafbfc;
        color: #6b7280;
        font-size: .85rem;
    }

    @@media (max-width: 767.98px) {
        .dv-table thead {
            display: none;
        }

        .dv-table, .dv-table tbody, .dv-table tr, .dv-table td {
            display: block;
            width: 100%;
        }

            .dv-table tbody tr {
                padding: 12px 16px;
                border-bottom: 1px solid #eef0f3;
            }

            .dv-table tbody td {
                border: 0;
                padding: 4px 0;
            }

                .dv-table tbody td.dv-act {
                    padding-top: 10px;
                }

            .dv-table .dv-action {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="dv-wrap">
    <div class="dv-head">
        <div>
            <h2 class="dv-title">Chọn đơn để thêm dịch vụ</h2>
            <p class="dv-sub">Các đơn đặt sân đang ở trạng thái "Đang xử lý". Chọn một đơn để thêm dịch vụ và tính tiền.</p>
        </div>
        <span class="dv-count"><i class="bi bi-receipt me-1"></i>@dsDon.Count đơn</span>
    </div>

    <partial name="_ThongBaoDichVu" />

    <div class="dv-card">
        <div class="dv-toolbar">
            <form method="get" class="dv-search">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="Tìm theo khách hàng hoặc tên sân..." autocomplete="off" />
                    @if (!string.IsNullOrWhiteSpace(tuKhoa))
                    {
                        <a asp-action="@ViewContext.RouteData.Values["action"]" class="btn btn-clear" title="Xóa tìm kiếm"><i class="bi bi-x-lg"></i></a>
                    }
                    <button class="btn btn-primary btn-find" type="submit">Tìm</button>
                </div>
            </form>
        </div>

        @if (!dsDon.Any())
        {
            <div class="dv-empty">
                <i class="bi bi-inbox"></i>
                @if (!string.IsNullOrWhiteSpace(tuKhoa))
                {
                    <div class="fw-semibold">Không tìm thấy đơn phù hợp với "@tuKhoa"</div>
                    <div class="small mt-1">Hãy thử từ khóa khác hoặc xóa bộ lọc.</div>
                }
                else
                {
                    <div class="fw-semibold">Không có đơn nào ở trạng thái "Đang xử lý"</div>
                    <div class="small mt-1">Khi có đơn mới, chúng sẽ xuất hiện tại đây.</div>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table dv-table align-middle">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Sân</th>
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in dsDon)
                        {
                            var tenKH = d.KhachHang?.HoTen ?? "—";
                            var chuCai = tenKH.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
                            var avatar = string.IsNullOrEmpty(chuCai) ? "?" : chuCai.Substring(0, 1).ToUpper();
                            var tenSanFull = d.SanTheThao?.TenSan ?? "—";
                            var phan = tenSanFull.Split(" - ", 2);
                            <tr>
                                <td><span class="dv-id">#@d.MaDatSan</span></td>
                                <td>
                                    <div class="dv-cust">
                                        <span class="dv-avatar">@avatar</span>
                                        <span class="dv-main">@tenKH</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="dv-main">@phan[0]</div>
                                    @if (phan.Length > 1)
                                    {
                                        <div class="dv-muted">@phan[1]</div>
                                    }
                                </td>
                                <td>
                                    <div class="dv-main"><i class="bi bi-calendar3 me-1 text-secondary"></i>@d.NgayDat.ToString("dd/MM/yyyy")</div>
                                    <div class="dv-muted"><i class="bi bi-clock me-1"></i>@d.GioBatDau.ToString("HH:mm") - @d.GioKetThuc.ToString("HH:mm")</div>
                                </td>
                                <td><span class="dv-badge">@d.TrangThai</span></td>
                                <td class="dv-act text-end">
                                    <a class="btn btn-sm btn-primary dv-action" asp-action="ChiTietDon" asp-route-maDatSan="@d.MaDatSan">
                                        <i class="bi bi-plus-circle me-1"></i>Thêm dịch vụ
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dv-foot">
                Hiển thị @dsDon.Count đơn@(string.IsNullOrWhiteSpace(tuKhoa) ? "" : $" cho từ khóa \"{tuKhoa}\"")
            </div>
        }
    </div>
</div>