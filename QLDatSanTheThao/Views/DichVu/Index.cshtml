@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Quản lý dịch vụ (Xem chi tiết & Sửa dạng Modal - Admin). *@
@model List<QLDatSanTheThao.Models.Entities.DichVu>
@{
    ViewData["Title"] = "Quản lý dịch vụ";
    bool laAdmin = ViewBag.LaAdmin;
    int trang = ViewBag.Trang;
    int tongTrang = ViewBag.TongTrang;
}

<!-- Sử dụng Bootstrap Icons cho giao diện trực quan -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<!-- Thêm CSS của SweetAlert2 để giao diện thông báo đẹp mắt -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="container-fluid px-4 py-3 bg-light min-vh-100">
    <!-- Tiêu đề trang & Nút hành động chính -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý dịch vụ</h2>
            <p class="text-muted mb-0">Quản lý danh sách, đơn giá và trạng thái các dịch vụ đi kèm sân thể thao.</p>
        </div>
        @if (laAdmin)
        {
            <a class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm px-3" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Thêm dịch vụ mới
            </a>
        }
    </div>

    <!-- Thông báo hệ thống -->
    <partial name="_ThongBaoDichVu" />

    <!-- Bảng danh sách dịch vụ -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-uppercase fs-7 border-bottom" style="background-color: black !important;">
                    <tr>
                        <th class="py-3 ps-4" style="width: 60px; color: white !important; background-color: transparent;">Mã</th>
                        <th class="py-3" style="color: white !important; background-color: transparent;">Tên dịch vụ</th>
                        <th class="py-3" style="color: white !important; background-color: transparent;">Mô tả</th>
                        <th class="py-3 text-end" style="color: white !important; background-color: transparent;">Đơn giá</th>
                        <th class="py-3 text-center" style="width: 150px; color: white !important; background-color: transparent;">Trạng thái</th>
                        <th class="py-3 text-center" style="width: 160px; color: white !important; background-color: transparent;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="my-2">
                                    <i class="bi bi-inbox display-4 text-secondary opacity-50"></i>
                                </div>
                                <p class="mb-0">Chưa có dịch vụ nào.</p>
                            </td>
                        </tr>
                    }
                    @{
                        int stt = (trang - 1) * 8;
                    }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">@(++stt)</td>
                            <td>
                                <span class="fw-bold text-dark">@d.TenDichVu</span>
                            </td>
                            <td>
                                <span class="text-muted text-truncate d-inline-block" style="max-width: 250px;" title="@d.MoTa">
                                    @(string.IsNullOrEmpty(d.MoTa) ? "-" : d.MoTa)
                                </span>
                            </td>
                            <td class="text-end fw-bold text-primary">@d.DonGia.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (d.TrangThai)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-dash-circle-fill me-1"></i> Ngừng cung cấp
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <!-- Nút mở Modal Xem chi tiết -->
                                    <button type="button" class="btn btn-sm btn-light border text-info shadow-sm" data-bs-toggle="modal" data-bs-target="#detailModal-@d.MaDichVu" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    @if (laAdmin)
                                    {
                                        <!-- Nút mở Modal Chỉnh sửa -->
                                        <button type="button" class="btn btn-sm btn-light border text-warning shadow-sm" data-bs-toggle="modal" data-bs-target="#editModal-@d.MaDichVu" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <form asp-action="DoiTrangThai" asp-route-id="@d.MaDichVu" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-light border text-secondary shadow-sm" title="@(d.TrangThai ? "Ngừng cung cấp" : "Kích hoạt lại")">
                                                <i class="bi @(d.TrangThai ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>

                                        <!-- Nút Xóa gọi hàm SweetAlert2 -->
                                        <button type="button" class="btn btn-sm btn-light border text-danger shadow-sm" title="Xóa dịch vụ"
                                                onclick="xacNhanXoa(@d.MaDichVu, '@Html.Raw(d.TenDichVu)')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        <!-- Modal Xem Chi Tiết -->
                        <div class="modal fade" id="detailModal-@d.MaDichVu" tabindex="-1" aria-labelledby="detailModalLabel-@d.MaDichVu" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                                    <div class="modal-header bg-light border-bottom py-3 px-4">
                                        <h5 class="modal-title fw-bold text-dark" id="detailModalLabel-@d.MaDichVu">Thông tin chi tiết dịch vụ</h5>
                                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4 text-start">
                                        <div class="mb-3 pb-2 border-bottom">
                                            <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Tên dịch vụ</span>
                                            <span class="fw-bold text-dark fs-5">@d.TenDichVu</span>
                                        </div>
                                        <div class="mb-3 pb-2 border-bottom">
                                            <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Mã dịch vụ</span>
                                            <span class="text-dark">#@d.MaDichVu</span>
                                        </div>
                                        <div class="mb-3 pb-2 border-bottom">
                                            <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Đơn giá</span>
                                            <span class="fw-bold text-primary fs-5">@d.DonGia.ToString("N0") đ</span>
                                        </div>
                                        <div class="mb-3 pb-2 border-bottom">
                                            <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Mô tả chi tiết</span>
                                            <span class="text-muted">@(string.IsNullOrWhiteSpace(d.MoTa) ? "(không có mô tả)" : d.MoTa)</span>
                                        </div>
                                        <div class="mb-0">
                                            <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Trạng thái</span>
                                            @if (d.TrangThai)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                                    Hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                                    Ngừng cung cấp
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="modal-footer bg-light border-top py-3 px-4">
                                        <button type="button" class="btn btn-secondary px-4 shadow-sm" data-bs-dismiss="modal">Đóng</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (laAdmin)
                        {
                            <!-- Modal Form Chỉnh sửa dịch vụ -->
                            <div class="modal fade" id="editModal-@d.MaDichVu" tabindex="-1" aria-labelledby="editModalLabel-@d.MaDichVu" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                                        <div class="modal-header bg-light border-bottom py-3 px-4">
                                            <h5 class="modal-title fw-bold text-dark" id="editModalLabel-@d.MaDichVu">Chỉnh sửa dịch vụ</h5>
                                            <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="Edit" method="post">
                                            <div class="modal-body p-4 text-start">
                                                <input type="hidden" name="MaDichVu" value="@d.MaDichVu" />

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary small text-uppercase">
                                                        Tên dịch vụ <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="text" name="TenDichVu" value="@d.TenDichVu" class="form-control rounded-3 shadow-none" required placeholder="Nhập tên dịch vụ..." />
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary small text-uppercase">
                                                        Đơn giá (đ) <span class="text-danger">*</span>
                                                    </label>
                                                    <div class="input-group">
                                                        <input type="number" name="DonGia" value="@d.DonGia" min="0" step="1000" class="form-control rounded-start-3 shadow-none" required placeholder="0" />
                                                        <span class="input-group-text bg-light text-muted fw-semibold rounded-end-3">VNĐ</span>
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary small text-uppercase">
                                                        Mô tả chi tiết
                                                    </label>
                                                    <textarea name="MoTa" class="form-control rounded-3 shadow-none" rows="3" placeholder="Nhập mô tả về dịch vụ (nếu có)...">@d.MoTa</textarea>
                                                </div>

                                                <div class="card bg-light border-0 rounded-3 p-3 mb-0">
                                                    <div class="form-check form-switch ps-0 d-flex justify-content-between align-items-center mb-0">
                                                        <label class="form-check-label fw-semibold text-dark mb-0 cursor-pointer" for="trangThaiSwitch-@d.MaDichVu">
                                                            Trạng thái hoạt động
                                                        </label>
                                                        <input class="form-check-input fs-5 ms-3 shadow-none" type="checkbox" role="switch" id="trangThaiSwitch-@d.MaDichVu" name="TrangThai" value="true" @(d.TrangThai ? "checked" : "") />
                                                        <input type="hidden" name="TrangThai" value="false" />
                                                    </div>
                                                    <small class="text-muted mt-1" style="font-size: 0.8rem;">Bật để cho phép khách hàng tiếp tục chọn dịch vụ này khi đặt sân.</small>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light border-top py-3 px-4">
                                                <button type="button" class="btn btn-light border px-4 shadow-sm text-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                                                <button type="submit" class="btn btn-primary px-4 shadow-sm">Lưu thay đổi</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Chân trang: thống kê & phân trang -->
        @if (Model.Any())
        {
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="text-muted small">
                    Tổng số: <span class="fw-bold text-dark">@ViewBag.TongSo</span> dịch vụ
                    @if (tongTrang > 1)
                    {
                        <span>(trang <span class="fw-bold text-dark">@trang</span> / <span class="fw-bold text-dark">@tongTrang</span>)</span>
                    }
                </div>

                @if (tongTrang > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0 shadow-sm rounded">
                            <li class="page-item @(trang == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-trang="@(trang - 1)">
                                    <i class="bi bi-chevron-left"></i> Trước
                                </a>
                            </li>
                            @for (int i = 1; i <= tongTrang; i++)
                            {
                                <li class="page-item @(i == trang ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-trang="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(trang == tongTrang ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-trang="@(trang + 1)">
                                    Sau <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Thêm thư viện JS của SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function xacNhanXoa(id, tenDichVu) {
        Swal.fire({
        title: 'Xác nhận xóa dịch vụ?',
        html: `Bạn có chắc chắn muốn xóa dịch vụ <b>"${tenDichVu}"</b> không?<br>Hành động này không thể hoàn tác!`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="bi bi-trash me-1"></i> Xóa',
        cancelButtonText: 'Hủy',
        reverseButtons: true,
        customClass: {
        popup: 'rounded-4 shadow-lg'
        }
        }).then((result) => {
        if (result.isConfirmed) {
        // Tạo form ẩn để gửi request POST về action Delete
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("Delete", "DichVu")/' + id;

        // Đính kèm AntiForgeryToken nếu có bảo mật CSRF trong project
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
        form.appendChild(token.cloneNode(true));
        }

        document.body.appendChild(form);
        form.submit();
        }
        });
        }
    </script>
}