@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Form sửa dịch vụ (Admin). *@
@model List<QLDatSanTheThao.Models.Entities.DichVu>
@{
    ViewData["Title"] = "Quản lý dịch vụ";
    bool laAdmin = ViewBag.LaAdmin;
    int trang = ViewBag.Trang;
    int tongTrang = ViewBag.TongTrang;
    string? tuKhoa = ViewBag.TuKhoa;
    bool? trangThai = ViewBag.TrangThai;
    string? sapXep = ViewBag.SapXep;
}

<!-- Sử dụng Bootstrap Icons cho giao diện trực quan -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid px-4 py-3">
    <!-- Tiêu đề trang & Nút hành động chính -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quản lý dịch vụ</h2>
            <p class="text-muted mb-0">Quản lý danh sách, đơn giá và trạng thái các dịch vụ đi kèm sân thể thao.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm" asp-action="DonDatSan">
                <i class="bi bi-receipt"></i> Thêm dịch vụ vào đơn
            </a>
            @if (laAdmin)
            {
                <a class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm px-3" asp-action="Create">
                    <i class="bi bi-plus-lg"></i> Thêm dịch vụ mới
                </a>
            }
        </div>
    </div>

    <!-- Thông báo hệ thống -->
    <partial name="_ThongBaoDichVu" />

    <!-- Khu vực Tìm kiếm & Lọc -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-3 p-md-4">
            <form id="formTimKiem" method="get" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="tuKhoaInput" name="tuKhoa" value="@tuKhoa" class="form-control border-start-0 ps-0 shadow-none" placeholder="Tìm theo tên dịch vụ..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="trangThaiSelect" name="trangThai" class="form-select shadow-none">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true" selected="@(trangThai == true)">Hoạt động</option>
                        <option value="false" selected="@(trangThai == false)">Ngừng cung cấp</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="sapXepSelect" name="sapXep" class="form-select shadow-none">
                        <option value="">Sắp xếp: Tên A → Z</option>
                        <option value="ten_giam" selected="@(sapXep == "ten_giam")">Tên Z → A</option>
                        <option value="gia_tang" selected="@(sapXep == "gia_tang")">Đơn giá tăng dần</option>
                        <option value="gia_giam" selected="@(sapXep == "gia_giam")">Đơn giá giảm dần</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <!-- Nút Lọc đồng bộ màu xanh chủ đạo thay vì màu đen -->
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-1 shadow-sm">
                        <i class="bi bi-funnel"></i> Lọc kết quả
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- KHU VỰC CHỨA BẢNG VÀ PHÂN TRANG ĐỂ CẬP NHẬT AJAX -->
    <div id="danhSachContainer">
        <!-- Bảng danh sách dịch vụ -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <!-- Đổi màu nền tiêu đề thành đen, chữ thành trắng -->
                    <thead class="text-uppercase fs-7 border-bottom" style="background-color: black !important;">
                        <tr>
                            <th class="py-3 ps-4" style="width: 60px; color: white !important; background-color: transparent;">#</th>
                            <th class="py-3" style="width: 70px; color: white !important; background-color: transparent;">Ảnh</th>
                            <th class="py-3" style="color: white !important; background-color: transparent;">Tên dịch vụ</th>
                            <th class="py-3" style="color: white !important; background-color: transparent;">Mô tả</th>
                            <th class="py-3 text-end" style="color: white !important; background-color: transparent;">Đơn giá</th>
                            <th class="py-3 text-center" style="width: 150px; color: white !important; background-color: transparent;">Trạng thái</th>
                            <th class="py-3 text-center" style="width: 150px; color: white !important; background-color: transparent;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="my-2">
                                        <i class="bi bi-inbox display-4 text-secondary opacity-50"></i>
                                    </div>
                                    <p class="mb-0">Không tìm thấy dịch vụ nào phù hợp.</p>
                                </td>
                            </tr>
                        }
                        @{
                            int stt = (trang - 1) * 8;
                        }
                        @foreach (var d in Model)
                        {
                            // Tự động phân loại icon trực quan dựa theo tên dịch vụ
                            string iconClass = "bi-box-seam";
                            string tenLower = d.TenDichVu.ToLower();
                            if (tenLower.Contains("nước") || tenLower.Contains("aquafina") || tenLower.Contains("redbull") || tenLower.Contains("giải khát"))
                            {
                                iconClass = "bi-cup-straw text-info";
                            }
                            else if (tenLower.Contains("áo") || tenLower.Contains("bib") || tenLower.Contains("quần"))
                            {
                                iconClass = "bi-tshirt text-warning";
                            }
                            else if (tenLower.Contains("bóng") || tenLower.Contains("vợt") || tenLower.Contains("cầu lông"))
                            {
                                iconClass = "bi-controller text-success";
                            }

                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">@(++stt)</td>
                                <td>
                                    <div class="rounded-3 bg-light d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                        <i class="bi @iconClass fs-5"></i>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@d.TenDichVu</span>
                                </td>
                                <td>
                                    <span class="text-muted text-truncate d-inline-block" style="max-width: 250px;" title="@d.MoTa">
                                        @(string.IsNullOrEmpty(d.MoTa) ? "-" : d.MoTa)
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-primary">@d.DonGia.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (d.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-dash-circle-fill me-1"></i> Ngừng cung cấp
                                        </span>
                                    }
                                </td>
                                <!-- Thao tác nhanh trực tiếp (1 chạm) giúp tối ưu trải nghiệm -->
                                <td class="text-center pe-4">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@d.MaDichVu" class="btn btn-sm btn-light border text-info shadow-sm" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (laAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@d.MaDichVu" class="btn btn-sm btn-light border text-warning shadow-sm" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <form asp-action="DoiTrangThai" asp-route-id="@d.MaDichVu" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-light border text-secondary shadow-sm" title="@(d.TrangThai ? "Ngừng cung cấp" : "Kích hoạt lại")">
                                                    <i class="bi @(d.TrangThai ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                </button>
                                            </form>
                                            <a asp-action="Delete" asp-route-id="@d.MaDichVu" class="btn btn-sm btn-light border text-danger shadow-sm" title="Xóa dịch vụ" onclick="return confirm('Bạn có chắc chắn muốn xóa dịch vụ này không?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Chân trang: Phân trang & Thông tin thống kê -->
            @if (tongTrang > 1 || Model.Any())
            {
                <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div class="text-muted small">
                        Hiển thị trang <span class="fw-bold text-dark">@trang</span> / <span class="fw-bold text-dark">@tongTrang</span>
                        (Tổng số: <span class="fw-bold text-dark">@ViewBag.TongSo</span> dịch vụ)
                    </div>

                    @if (tongTrang > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0 shadow-sm rounded">
                                <li class="page-item @(trang == 1 ? "disabled" : "")">
                                    <a class="page-link ajax-link" href="#" data-trang="@(trang - 1)">
                                        <i class="bi bi-chevron-left"></i> Trước
                                    </a>
                                </li>
                                @for (int i = 1; i <= tongTrang; i++)
                                {
                                    <li class="page-item @(i == trang ? "active" : "")">
                                        <a class="page-link ajax-link" href="#" data-trang="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(trang == tongTrang ? "disabled" : "")">
                                    <a class="page-link ajax-link" href="#" data-trang="@(trang + 1)">
                                        Sau <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("formTimKiem");
            const container = document.getElementById("danhSachContainer");

            function taiDuLieuAjax(url) {
                fetch(url, {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newContent = doc.getElementById("danhSachContainer");
                    if (newContent) {
                        container.innerHTML = newContent.innerHTML;
                        ganSuKienPhanTrang();
                    }
                })
                .catch(err => console.error("Lỗi khi tải dữ liệu AJAX:", err));
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                const formData = new FormData(form);
                const queryString = new URLSearchParams(formData).toString();
                const url = `${window.location.pathname}?${queryString}`;

                history.pushState({}, '', url);
                taiDuLieuAjax(url);
            });

            function ganSuKienPhanTrang() {
                const pageLinks = container.querySelectorAll(".ajax-link");
                pageLinks.forEach(link => {
                    link.addEventListener("click", function (e) {
                        e.preventDefault();
                        const trangMoi = this.getAttribute("data-trang");

                        const formData = new FormData(form);
                        formData.set("trang", trangMoi);

                        const queryString = new URLSearchParams(formData).toString();
                        const url = `${window.location.pathname}?${queryString}`;

                        history.pushState({}, '', url);
                        taiDuLieuAjax(url);
                    });
                });
            }

            ganSuKienPhanTrang();
        });
    </script>
}